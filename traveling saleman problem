
#include <iostream>
#include <algorithm>
using namespace std;

int main()
{
    int n = 4;

    int cost[4][4] = {
        {0, 10, 15, 20},
        {10, 0, 35, 25},
        {15, 35, 0, 30},
        {20, 25, 30, 0}
    };

    int city[] = {1, 2, 3};
    int minCost = 999999;

    do
    {
        int total = cost[0][city[0]]
                  + cost[city[0]][city[1]]
                  + cost[city[1]][city[2]]
                  + cost[city[2]][0];

        if (total < minCost)
        {
            minCost = total;
        }

    } while (next_permutation(city, city + 3));

    cout << "Minimum travelling cost = " << minCost << endl;

    return 0;
}
